{
  "name": "sudojo_api",
  "version": "1.0.177",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "license": "BUSL-1.1",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "build:compile": "bun build src/index.ts --compile --outfile dist/server",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:unit": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "db:init": "bun run src/db/init.ts",
    "db:seed-badges": "bun run src/db/seed-badges.ts",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "devDependencies": {
    "@sudobility/test-db-guard": "^1.0.3",
    "@types/bun": "latest",
    "@types/node": "~24.19.2",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "drizzle-kit": "~0.31.11",
    "eslint": "~9.39.5",
    "eslint-plugin-import": "~2.32.0",
    "prettier": "~3.9.10",
    "typescript": "~5.9.3",
    "vitest": "~4.1.12"
  },
  "dependencies": {
    "@hono/zod-validator": "~0.7.6",
    "@napi-rs/canvas": "~0.1.100",
    "@sudobility/auth_service": "^1.1.30",
    "@sudobility/subscription_service": "^1.0.32",
    "@sudobility/sudojo_ocr": "^1.1.55",
    "@sudobility/sudojo_types": "^1.2.79",
    "@sudobility/types": "^1.9.76",
    "drizzle-orm": "~0.45.4",
    "firebase-admin": "~13.10.0",
    "hono": "~4.11.5",
    "postgres": "~3.4.9",
    "zod": "~4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/sudojo_api.git"
  }
}
