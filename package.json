{
  "name": "sudojo_api",
  "version": "1.0.173",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "license": "BUSL-1.1",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "build:compile": "bun build src/index.ts --compile --outfile dist/server",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:unit": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "db:init": "bun run src/db/init.ts",
    "db:seed-badges": "bun run src/db/seed-badges.ts",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "devDependencies": {
    "@sudobility/test-db-guard": "^1.0.3",
    "@types/bun": "latest",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.4"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.5",
    "@napi-rs/canvas": "^0.1.68",
    "@sudobility/auth_service": "^1.1.27",
    "@sudobility/subscription_service": "^1.0.29",
    "@sudobility/sudojo_ocr": "^1.1.51",
    "@sudobility/sudojo_types": "^1.2.75",
    "@sudobility/types": "^1.9.74",
    "drizzle-orm": "^0.45.0",
    "firebase-admin": "^13.6.0",
    "hono": "^4.10.7",
    "postgres": "^3.4.7",
    "zod": "^4.1.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/sudojo_api.git"
  }
}
